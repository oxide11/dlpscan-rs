/target

# Secrets and credentials
.env
.env.*
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
secrets/
certs/

# Logs (may contain PII from scan results)
*.log

# Databases
*.sqlite
*.db

# OS
.DS_Store
Thumbs.db

# Large test corpora — fetched, not committed. See scripts/fetch-corpus.sh and
# tests/corpus/*/PROVENANCE.md. The threshold is 1 MB per file; everything
# smaller (provenance, manifest, checksums, registries) stays in git so a
# fetched copy is verifiable.
tests/corpus/*/*.jsonl
tests/corpus/*/polygon_siphon_entities_v1.csv
tests/corpus/*/polygon_siphon_dlp_eval_v1.csv
