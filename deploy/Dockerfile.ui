# Standalone console image for the kind lab, where nginx-ingress fronts a
# separate `siphon-ui` Service rather than the all-in-one proxy image.
#
# Same two-stage shape as deploy/nginx/Dockerfile: Node builds, nginx serves,
# no JavaScript runtime in the deployed artifact. Build from the repo root.

FROM node:22-alpine AS console

RUN corepack enable
WORKDIR /build

COPY console/package.json console/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY console/ ./
RUN pnpm build


FROM nginx:1.31-alpine AS runtime

COPY --from=console /build/dist/ /usr/share/nginx/html/

# SPA fallback: the console's routes are real URLs owned by the client router,
# so a refresh or a pasted deep link asks this server for a file that does not
# exist. Without it every shared URL 404s.
RUN printf '%s\n' \
    'server {' \
    '  listen 80;' \
    '  root /usr/share/nginx/html;' \
    '  location / { try_files $uri $uri/ /index.html; }' \
    '  location = /index.html { add_header Cache-Control "no-cache"; }' \
    '}' > /etc/nginx/conf.d/default.conf
