# Siphon-milter — SMTP content DLP for Postfix and Sendmail.
#
# Copies `crates/` wholesale rather than enumerating each member's
# Cargo.toml for a stub layer, as Dockerfile.api and Dockerfile.icap do.
# That stub trick buys layer caching but silently breaks every time a
# workspace member is added: cargo parses the whole workspace even for
# `-p <one-crate>`, so a member whose manifest was not copied fails the
# build with "failed to load manifest for workspace member". Adding
# siphon-mail and siphon-milter broke both of those files, and this one
# cannot drift the same way. Dockerfile.fs already takes this approach.

FROM rust:1.98-bookworm AS builder

# Optional cargo parallelism cap, matching Dockerfile.fs: this crate pulls
# the root siphon crate for its extractors, so rav1e / arrow / parquet
# codegen is in the graph and can exceed a CI runner's memory ceiling.
ARG CARGO_BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}

WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY crates/ crates/
COPY src/ src/
# The workspace root declares [[bench]] name = "scanning"; cargo parses the
# whole workspace even for `-p siphon-milter`, so the bench source has to
# exist at image-build time.
COPY benches/ benches/

RUN cargo build --release -p siphon-milter --locked

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r siphon && useradd -r -g siphon -s /bin/false siphon

COPY --from=builder /app/target/release/siphon-milter /usr/local/bin/siphon-milter

USER siphon
EXPOSE 8894

ENTRYPOINT ["siphon-milter"]

# No HEALTHCHECK. The milter protocol has no bare liveness probe: the first
# thing a client must send is an option-negotiation packet, and answering one
# would mean speaking the protocol from a shell. A TCP connect proves only
# that the listener is up, which the orchestrator's own port check already
# establishes — see the chart's tcpSocket probe.

LABEL org.opencontainers.image.title="siphon-milter" \
      org.opencontainers.image.description="Polygon Siphon milter — SMTP content DLP for Postfix and Sendmail" \
      org.opencontainers.image.version="0.1.0"
