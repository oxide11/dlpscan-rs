# Siphon compose env — copy to deploy/.env and fill in real values.
#
# Generate each secret with:
#   openssl rand -hex 32
# Each must be at least 32 bytes. The compose file uses ${VAR:?...}
# syntax and will refuse to start if any of these are unset or empty.

# --- Authelia auth secrets (required) ------------------------------------
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# --- siphon-api API key (optional — or set SIPHON_ALLOW_UNAUTHENTICATED=true)
# Generate with: openssl rand -hex 32
SIPHON_API_KEY=

# --- Postgres (required for the auth profile) ----------------------------
# The password is one of two factors: every network connection to the
# database also has to present a client certificate whose CN is the role
# (deploy/postgres/pg_hba.conf). Generate with: openssl rand -hex 32
SIPHON_DATABASE_PASSWORD=

# --- Sensor telemetry (optional, recommended) ----------------------------
# One key with the Sensor role, shared by siphon-fs, siphon-icap and
# siphon-smtp to report heartbeats (mTLS health, availability, counters)
# to siphon-api. Issue it once the stack is up, with an admin credential:
#
#   curl -sS https://localhost:8080/api/v1/keys -H "Authorization: Bearer $SIPHON_API_KEY" \
#        -H 'Content-Type: application/json' \
#        -d '{"label":"sensors","role":"sensor","never_expires":true}'
#
# and put the returned `secret` here, then `docker compose up -d` again.
# Unset = those sensors show as "never seen" on the Running page.
SIPHON_TELEMETRY_KEY=

# --- Sensor objectives (optional) ----------------------------------------
# What the Running page judges each ACEE axis against. Fractions 0–1. Unset
# = the declared defaults (availability 0.99, coverage 0.95, precision 0.80,
# canary 1.0) and the response says "defaults". These should come from an
# objectives layer; until one exists, set them to what your obligations
# actually require. An unparseable value refuses to start.
SIPHON_SENSORS_TARGET_AVAILABILITY=
SIPHON_SENSORS_TARGET_COVERAGE=
SIPHON_SENSORS_TARGET_PRECISION=
SIPHON_SENSORS_TARGET_CANARY=
# Comma-separated. Coverage against the matrix is measured over this list
# and "never seen" names its gaps. Default: all four sensors.
SIPHON_SENSORS_EXPECTED=

# --- Internal mutual TLS (required for the auth profile) -----------------
# Not variables — files. Before `docker compose --profile auth up`, run
#
#   scripts/dev/mkcerts.sh
#
# which writes deploy/certs/ (gitignored): a private CA and one identity per
# service. The `certs-init` service copies them into per-service volumes with
# the right ownership. To rotate, delete deploy/certs/ and run it again.

# --- Authelia OIDC optional -----------------------------------------------
# Only needed if you configure Authelia as an OIDC provider.
# See deploy/authelia/configuration.yml for the full list of secrets.

# --- ICAP / SMTP allowed networks -----------------------------------------
# Override the default (127.0.0.0/8 loopback) to your proxy/MTA subnet.
# SIPHON_ICAP_ALLOWED_NETS=10.0.0.0/8
# SIPHON_SMTP_ALLOWED_NETS=10.0.0.0/8
